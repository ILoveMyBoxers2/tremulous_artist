<script>
(function(){
	try{
		var FALLBACK=48;
		var shifted=[];
		function ribbon(){return document.querySelector('.lindo-ribbon');}
		function ribbonH(){var b=ribbon();return b&&b.offsetHeight?b.offsetHeight:FALLBACK;}
		function scan(){
			var b=ribbon();if(!b||!document.body)return;
			var h=ribbonH();
			var nodes=document.body.getElementsByTagName('*');
			for(var i=0;i<nodes.length;i++){
				var el=nodes[i];
				if(el===b||b.contains(el)||el.hasAttribute('data-lindo-top'))continue;
				var cs=window.getComputedStyle(el);
				if(cs.position==='fixed'||cs.position==='sticky'){
					var t=parseFloat(cs.top);
					if(!isNaN(t)&&t<h){
						el.setAttribute('data-lindo-top',String(t));
						el.style.top=(t+h)+'px';
						shifted.push(el);
					}
				}
			}
		}
		function reflow(){
			var h=ribbonH();
			document.documentElement.style.setProperty('--lindo-ribbon-h',h+'px');
			for(var i=0;i<shifted.length;i++){
				var orig=parseFloat(shifted[i].getAttribute('data-lindo-top'))||0;
				shifted[i].style.top=(orig+h)+'px';
			}
		}
		function init(){scan();reflow();}
		if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}
		var rt;window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(reflow,150);});
	}catch(e){}
})();
</script>
